# Vite variables are public. Never put financial provider credentials here.
VITE_API_BASE_URL=http://127.0.0.1:8000
# demo or provider; selecting a mode never silently falls back to demo data.
VITE_DATA_MODE=demo
# Development-only PostgreSQL defaults used by docker-compose.yml.
POSTGRES_DB=fairworth
POSTGRES_USER=fairworth
POSTGRES_PASSWORD=fairworth_local
POSTGRES_PORT=5440
