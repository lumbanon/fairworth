# Copy to backend/.env; never commit credentials or a real identifying contact.
DATABASE_URL=postgresql+psycopg://fairworth:fairworth_local@127.0.0.1:5440/fairworth
# Required before requesting SEC data: organization/product and monitored contact.
SEC_USER_AGENT=
SEC_MIN_INTERVAL_SECONDS=0.2
PROVIDER_TIMEOUT_SECONDS=20
PROVIDER_RETRIES=2
# disabled or fmp; configure your own license/API key before enabling FMP.
MARKET_DATA_PROVIDER=disabled
FMP_API_KEY=
# Free-plan acquisition is opt-in per exact symbol/endpoint after reviewing access.
# Empty means cached data only. This is permission, not proof of entitlement.
FMP_AUTHORIZED_ENDPOINTS={}
FMP_ACCESS_REVIEW_ID=initial
FMP_DAILY_REQUEST_BUDGET=50
FMP_MINIMUM_REQUEST_INTERVAL_SECONDS=1
# Optional local research CLI only. No automatic connection or public IBKR proxy.
# Port deliberately unset: confirm the actual TWS/IB Gateway API port first.
IBKR_HOST=127.0.0.1
IBKR_PORT=
IBKR_CLIENT_ID=68
IBKR_TIMEOUT_SECONDS=15
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SEC_CACHE_TTL_SECONDS=21600
COMPANY_CACHE_TTL_SECONDS=86400
MARKET_CACHE_TTL_SECONDS=300
HISTORICAL_CACHE_TTL_SECONDS=3600
MARKET_MAX_AGE_SECONDS=172800
API_HISTORY_LIMIT=365
# Import an audited local registry snapshot before use. New SEC directory access
# is disabled unless the operator explicitly enables cold bootstrap.
REGISTRY_BOOTSTRAP_ENABLED=false
REGISTRY_CACHE_TTL_SECONDS=86400
# Illustrative modeling policy, never observed market rates or company facts.
VALUATION_INPUT_CACHE_SECONDS=60
VALUATION_CALCULATION_TIMEOUT_SECONDS=8
VALUATION_FORECAST_YEARS=5
VALUATION_TERMINAL_GROWTH=0.02
VALUATION_BENCHMARK_COST_OF_EQUITY=0.10
VALUATION_ALLOW_BENCHMARK_COST_OF_EQUITY=true
VALUATION_MINIMUM_FORECAST_GROWTH=-0.15
VALUATION_MAXIMUM_FORECAST_GROWTH=0.20
VALUATION_MAXIMUM_GROWTH_DISPERSION=1.0
VALUATION_HISTORICAL_MULTIPLE_YEARS=5
VALUATION_HISTORICAL_MULTIPLE_MINIMUM_YEARS=3
# Automatic inputs retain provider dates, entitlement failures and evidence quality.
VALUATION_AUTOMATIC_INPUTS_ENABLED=true
VALUATION_TREASURY_ENABLED=true
VALUATION_ASSUMPTION_CACHE_SECONDS=86400
# Optional research-policy ERP, expressed as a fraction. No numerical default.
# Supply all source, publication date and methodology fields to enable CAPM.
VALUATION_ERP_VALUE=
VALUATION_ERP_SOURCE=
VALUATION_ERP_PUBLICATION_DATE=
VALUATION_ERP_METHODOLOGY=
VALUATION_ERP_MARKET=US

# Phase 5: explicitly opt in and choose an approved structured-output model.
# All requests originate from FastAPI. Never use VITE_ for these values.
AI_RESEARCH_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REQUEST_TIMEOUT=45
OPENAI_MAX_OUTPUT_TOKENS=5000
# Conservative UTF-8-byte upper bound on input tokens, including schema/history.
AI_MAX_CONTEXT_TOKENS=64000
AI_REPORT_CACHE_TTL=1800
AI_MAX_CONCURRENT_REQUESTS=2
AI_CLIENT_REQUESTS_PER_MINUTE=6
AI_CLIENT_REQUESTS_PER_HOUR=20
AI_GLOBAL_GENERATIONS_PER_DAY=50
AI_FILINGS_ENABLED=true
AI_FILING_MAX_BYTES=1500000
AI_FILING_EXCERPT_CHARS=2500
AI_FILING_MAX_DOCUMENTS=2
AI_FILING_CACHE_TTL=86400
