# Copy to backend/.env; never commit credentials or a real identifying contact.
DATABASE_URL=postgresql+psycopg://fairworth:fairworth_local@127.0.0.1:5440/fairworth
# Required before requesting SEC data: organization/product and monitored contact.
SEC_USER_AGENT=
SEC_MIN_INTERVAL_SECONDS=0.2
PROVIDER_TIMEOUT_SECONDS=20
PROVIDER_RETRIES=2
# disabled or fmp; configure your own license/API key before enabling FMP.
MARKET_DATA_PROVIDER=disabled
FMP_API_KEY=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SEC_CACHE_TTL_SECONDS=21600
COMPANY_CACHE_TTL_SECONDS=86400
MARKET_CACHE_TTL_SECONDS=300
HISTORICAL_CACHE_TTL_SECONDS=3600
MARKET_MAX_AGE_SECONDS=172800
API_HISTORY_LIMIT=365
